;
; Samsung Galaxy S22 (SM-S901E, r0q / SM8450) PCIe0 DesignWare iMSI-RX -> GICD MSI Bridge
; Windows 11 ARM64 KMDF Driver (enables MSI delivery for WCN6855 Wi-Fi 6E)
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ManufacturerName%
CatalogFile = s22wlanpdc.cat
DriverVer   = 11/23/2026,1.0.19.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
s22wlanpdc.sys = 1

[Manufacturer]
%ManufacturerName% = Standard,NTARM64.10.0...22000

[Standard.NTARM64.10.0...22000]
%WlanBridge.DeviceDesc%  = WlanBridge_Install, ACPI\S22W0001
%WlanBridge.VirtualDesc% = WlanBridge_Install, ROOT\S22W0001

[WlanBridge_Install.NT]
CopyFiles = WlanBridge_CopyFiles

[WlanBridge_Install.NT.HW]
AddReg = WlanBridge_Security_AddReg

[WlanBridge_Security_AddReg]
; Restrict device interface / IOCTL access to SYSTEM and Administrators only
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[WlanBridge_CopyFiles]
s22wlanpdc.sys

[WlanBridge_Install.NT.Services]
AddService = s22wlanpdc, 0x00000002, WlanBridge_Service_Inst

[WlanBridge_Service_Inst]
DisplayName    = %WlanBridge.ServiceDesc%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\s22wlanpdc.sys

[WlanBridge_Install.NT.Wdf]
KmdfService = s22wlanpdc, WlanBridge_WdfSect

[WlanBridge_WdfSect]
KmdfLibraryVersion = 1.33

[Strings]
ManufacturerName       = "S22 Windows Community Project"
DiskName               = "Galaxy S22 SM8450 PCIe0 MSI Bridge Driver Package"
WlanBridge.DeviceDesc  = "Galaxy S22 SM8450 PCIe0 iMSI-RX to GICD MSI Bridge"
WlanBridge.VirtualDesc = "Galaxy S22 Virtual PCIe0 MSI Bridge (Test Mode)"
WlanBridge.ServiceDesc = "Galaxy S22 SM8450 PCIe0 DesignWare iMSI-RX to GICD MSI Bridge KMDF Driver"
