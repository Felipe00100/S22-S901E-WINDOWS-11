 /**
@@ -986,6 +1008,48 @@ BdsSetConsoleMode (
   @retval  EFI_NOT_FOUND        User select to enter setup or can not find boot option
 
 **/
+#define AUTO_BOOT_TIMEOUT_SECONDS  15
+#define TIMER_TICK_100NS           1000000ULL  // 100 ms
+#define TICKS_PER_SECOND           10
+#define COMBO_WINDOW_TICKS         4           // 400 ms window for Vol+ & Vol- combo
+
+STATIC
+VOID
+DrawAutoBootCountdown (
+  IN BOOT_MENU_POPUP_DATA  *BootMenuData,
+  IN UINTN                 SecondsLeft
+  )
+{
+  CHAR16  StatusLine[80];
+  UINTN   SavedAttribute;
+  UINTN   Row;
+  UINTN   Col;
+  UINTN   MaxCol;
+  UINTN   MaxRow;
+  UINTN   Len;
+
+  gST->ConOut->QueryMode (gST->ConOut, gST->ConOut->Mode->Mode, &MaxCol, &MaxRow);
+  Row = BootMenuData->MenuScreen.StartRow + BootMenuData->MenuScreen.Height;
+  if (Row >= MaxRow) {
+    Row = MaxRow - 1;
+  }
+
+  UnicodeSPrint (
+    StatusLine,
+    sizeof (StatusLine),
+    L"  Auto-boot in %02us | Vol+/Vol-: Move | Vol+ & Vol-: Enter  ",
+    (UINT32)SecondsLeft
+    );
+
+  Len = StrLen (StatusLine);
+  Col = (MaxCol > Len) ? ((MaxCol - Len) / 2) : 0;
+
+  SavedAttribute = gST->ConOut->Mode->Attribute;
+  gST->ConOut->SetAttribute (gST->ConOut, EFI_YELLOW | EFI_BACKGROUND_BLACK);
+  PrintStringAt (Col, Row, StatusLine);
+  gST->ConOut->SetAttribute (gST->ConOut, SavedAttribute);
+}
