+        //
+        // Back to boot manager menu again, set back to setup resolution
+        //
+        BdsSetConsoleMode (TRUE);
+        DrawBootPopupMenu (&BootMenuData);
+        CountdownSeconds = AUTO_BOOT_TIMEOUT_SECONDS;
+        TickCounter      = 0;
+        LastScanCode     = SCAN_NULL;
+        DrawAutoBootCountdown (&BootMenuData, CountdownSeconds);
+        if (TimerEvent != NULL) {
+          gBS->SetTimer (TimerEvent, TimerPeriodic, TIMER_TICK_100NS);
+        }
       }
     }
+
+    if (TimerEvent != NULL) {
+      gBS->SetTimer (TimerEvent, TimerCancel, 0);
+      gBS->CloseEvent (TimerEvent);
+    }
   }
 
   EfiBootManagerFreeLoadOptions (BootOption, BootOptionCount);
