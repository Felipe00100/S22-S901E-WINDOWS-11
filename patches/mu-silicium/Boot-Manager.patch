+
+      if (Index == 1) {
+        TotalTicks++;
+        TickCounter++;
+        if (TickCounter >= TICKS_PER_SECOND) {
+          TickCounter = 0;
+          if (CountdownSeconds > 0) {
+            CountdownSeconds--;
+          }
+
+          DrawAutoBootCountdown (&BootMenuData, CountdownSeconds);
+          if (CountdownSeconds == 0) {
+            ExecuteSelected = TRUE;
+          }
+        }
+      } else {
+        Status = gST->ConIn->ReadKeyStroke (gST->ConIn, &Key);
+        if (!EFI_ERROR (Status)) {
+          switch (Key.UnicodeChar) {
+            case CHAR_NULL:
+              switch (Key.ScanCode) {
+                case SCAN_UP:
+                case SCAN_DOWN:
+                  if ((LastScanCode != SCAN_NULL) &&
+                      (LastScanCode != Key.ScanCode) &&
+                      ((TotalTicks - LastKeyTick) <= COMBO_WINDOW_TICKS))
