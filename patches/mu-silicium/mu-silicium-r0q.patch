+S22AossQmpSend (
+  IN CONST CHAR8  *Msg
+  )
+{
+  UINT32 Magic;
+  UINT32 Ver;
+  UINT32 Offset;
+  UINT32 Size;
+  UINT32 Poll;
+  UINT32 Words[16];
+  UINTN  Len;
+  UINTN  i;
+
+  Magic = MmioRead32 (S22_AOSS_QMP_BASE + 0x00ULL);
+  Ver   = MmioRead32 (S22_AOSS_QMP_BASE + 0x04ULL);
+  if (Magic != 0x4D41494CU || Ver != 1U) {
+    mS22PcieQmpStep = 1;
+    return EFI_NOT_READY;
+  }
+
+  Offset = MmioRead32 (S22_AOSS_QMP_BASE + 0x38ULL);
+  Size   = MmioRead32 (S22_AOSS_QMP_BASE + 0x34ULL);
+  if (Size < 64U || Offset == 0 || (Offset + 68U) > 0x400U) {
+    mS22PcieQmpStep = 2;
+    return EFI_BAD_BUFFER_SIZE;
+  }
+
+  // Open QMP link/channel if not already open
+  if (MmioRead32 (S22_AOSS_QMP_BASE + 0x30ULL) != 0x0000FFFFU) {
+    UINT32 UcoreLink = MmioRead32 (S22_AOSS_QMP_BASE + 0x0CULL);
+    MmioWrite32 (S22_AOSS_QMP_BASE + 0x10ULL, UcoreLink);
+    MmioWrite32 (S22_AOSS_QMP_BASE + 0x24ULL, 0x0000FFFFU);
+    MmioWrite32 (S22_IPCC_SEND_ID, 0U);
+
+    for (Poll = 0; Poll < 500; Poll++) {
+      if (MmioRead32 (S22_AOSS_QMP_BASE + 0x28ULL) == 0x0000FFFFU) break;
+      gBS->Stall (1000);
+    }
+    if (MmioRead32 (S22_AOSS_QMP_BASE + 0x28ULL) != 0x0000FFFFU) {
+      mS22PcieQmpStep = 3;
+      return EFI_TIMEOUT;
+    }
+
+    MmioWrite32 (S22_AOSS_QMP_BASE + 0x2CULL, 0x0000FFFFU);
+    MmioWrite32 (S22_IPCC_SEND_ID, 0U);
+
+    for (Poll = 0; Poll < 500; Poll++) {
+      if (MmioRead32 (S22_AOSS_QMP_BASE + 0x14ULL) == 0x0000FFFFU) break;
+      gBS->Stall (1000);
+    }
+    if (MmioRead32 (S22_AOSS_QMP_BASE + 0x14ULL) != 0x0000FFFFU) {
+      mS22PcieQmpStep = 4;
+      return EFI_TIMEOUT;
+    }
+
+    MmioWrite32 (S22_AOSS_QMP_BASE + 0x18ULL, 0x0000FFFFU);
+    MmioWrite32 (S22_IPCC_SEND_ID, 0U);
+
+    for (Poll = 0; Poll < 500; Poll++) {
+      if (MmioRead32 (S22_AOSS_QMP_BASE + 0x30ULL) == 0x0000FFFFU) break;
+      gBS->Stall (1000);
+    }
+    if (MmioRead32 (S22_AOSS_QMP_BASE + 0x30ULL) != 0x0000FFFFU) {
+      mS22PcieQmpStep = 5;
+      return EFI_TIMEOUT;
+    }
+  }
+
+  for (Poll = 0; Poll < 200; Poll++) {
+    if (MmioRead32 (S22_AOSS_QMP_BASE + Offset) == 0U) break;
+    gBS->Stall (1000);
+  }
+  if (MmioRead32 (S22_AOSS_QMP_BASE + Offset) != 0U) {
+    mS22PcieQmpStep = 6;
+    return EFI_DEVICE_ERROR;
+  }
+
+  ZeroMem (Words, sizeof (Words));
+  Len = AsciiStrLen (Msg);
+  if (Len >= 64U) Len = 63U;
+  CopyMem (Words, Msg, Len);
+
+  for (i = 0; i < 16; i++) {
+    MmioWrite32 (S22_AOSS_QMP_BASE + Offset + 4ULL + (i * 4ULL), Words[i]);
+  }
+  MmioWrite32 (S22_AOSS_QMP_BASE + Offset, 64U);
+  (VOID)MmioRead32 (S22_AOSS_QMP_BASE + Offset);
+  MmioWrite32 (S22_IPCC_SEND_ID, 0U);
+
+  for (Poll = 0; Poll < 500; Poll++) {
+    if (MmioRead32 (S22_AOSS_QMP_BASE + Offset) == 0U) {
+      mS22PcieQmpStep = 9;
+      return EFI_SUCCESS;
+    }
+    gBS->Stall (1000);
+  }
+
+  MmioWrite32 (S22_AOSS_QMP_BASE + Offset, 0U);
+  mS22PcieQmpStep = 7;
+  return EFI_TIMEOUT;
+}
+#endif
+
+STATIC
+BOOLEAN
+S22ClockEnableOne (
+  IN EFI_CLOCK_PROTOCOL  *Clock,
+  IN CONST CHAR8         *Name,
+  IN UINT32              FreqHz
+  )
+{
+  UINTN  ClkId  = 0;
+  UINT32 ResHz  = 0;
+
+  if (EFI_ERROR (Clock->GetClockID (Clock, Name, &ClkId))) {
+    return FALSE;
+  }
+  if (FreqHz != 0) {
+    (VOID)Clock->SetClockFreqHz (Clock, ClkId, FreqHz, EFI_CLOCK_FREQUENCY_HZ_AT_LEAST, &ResHz);
+  }
+  return !EFI_ERROR (Clock->EnableClock (Clock, ClkId));
+}
+
+STATIC
+VOID
+S22InitWlanAndPcie0 (
+  VOID
+  )
+{
+  EFI_STATUS          Status;
+  EFI_CLOCK_PROTOCOL  *Clock = NULL;
+  UINTN               PdId   = 0;
+  UINTN               i;
+  UINT32              Val;
+  UINT32              Poll;
+
+  // 1. Skip AOSS QMP in UEFI (Windows qcpep8450.sys owns AOSS QMP channel; s3e.e is only for 2.4 GHz TX)
+  mS22PcieQmpOk   = 0;
+  mS22PcieQmpStep = 0;
+
+  // 2. Assert PERST# LOW & hold WCN6855 OFF while initializing PCIe0 controller & QMP PHY
+  //    (exact linux-7.2.11 qcom_pcie_host_init order: PERST assert -> init -> PHY power_on -> WCN pwrseq -> PERST deassert)
+  S22TlmmSetOutput (94, FALSE);   // PCIE0_RESET_N (PERST#) LOW
+  S22TlmmSetFunc   (95, 1, 3);    // PCIE0_CLKREQ_N func 1, pull-up
+  S22TlmmSetFunc   (96, 0, 3);    // PCIE0_WAKE_N input, pull-up
+  S22TlmmSetOutput (80, FALSE);   // WLAN_EN LOW
+  S22TlmmSetOutput (204, FALSE);  // XO_CLK LOW
+
+  // 3. Enable SM8450 PCIe0 power domains & clocks via ClockDxe
+  Status = gBS->LocateProtocol (&gEfiClockProtocolGuid, NULL, (VOID **)&Clock);
+  if (EFI_ERROR (Status) || Clock == NULL) {
+    return;
+  }
+
+  mS22PciePdMask  = 0;
+  mS22PcieClkMask = 0;
+
+  if (!EFI_ERROR (Clock->GetClockPowerDomainID (Clock, "gcc_hlos1_vote_aggre_noc_mmu_pcie_tbu_gds", &PdId)) &&
+      !EFI_ERROR (Clock->EnableClockPowerDomain (Clock, PdId)))
+  {
+    mS22PciePdMask |= (1U << 0);
+  }
+  if (!EFI_ERROR (Clock->GetClockPowerDomainID (Clock, "gcc_pcie_0_gdsc", &PdId)) &&
+      !EFI_ERROR (Clock->EnableClockPowerDomain (Clock, PdId)))
+  {
+    mS22PciePdMask |= (1U << 1);
+  }
+
+  if (S22ClockEnableOne (Clock, "gcc_aggre_noc_pcie_0_axi_clk", 0))                mS22PcieClkMask |= (1U << 0);
+  if (S22ClockEnableOne (Clock, "gcc_aggre_noc_pcie_1_axi_clk", 0))                mS22PcieClkMask |= (1U << 1);
+  if (S22ClockEnableOne (Clock, "gcc_cfg_noc_pcie_anoc_ahb_clk", 0))               mS22PcieClkMask |= (1U << 2);
+  if (S22ClockEnableOne (Clock, "gcc_ddrss_pcie_sf_tbu_clk", 0))                   mS22PcieClkMask |= (1U << 3);
+  if (S22ClockEnableOne (Clock, "gcc_hlos1_vote_aggre_noc_mmu_pcie_tbu_clk", 0))   mS22PcieClkMask |= (1U << 4);
+  if (S22ClockEnableOne (Clock, "gcc_pcie_0_aux_clk", 19200000))                   mS22PcieClkMask |= (1U << 5);
+  if (S22ClockEnableOne (Clock, "gcc_pcie_0_cfg_ahb_clk", 0))                      mS22PcieClkMask |= (1U << 6);
+  if (S22ClockEnableOne (Clock, "gcc_pcie_0_mstr_axi_clk", 0))                     mS22PcieClkMask |= (1U << 7);
+  if (S22ClockEnableOne (Clock, "gcc_pcie_0_slv_axi_clk", 0))                      mS22PcieClkMask |= (1U << 8);
+  if (S22ClockEnableOne (Clock, "gcc_pcie_0_slv_q2a_axi_clk", 0))                  mS22PcieClkMask |= (1U << 9);
+  if (S22ClockEnableOne (Clock, "gcc_pcie_0_clkref_en", 0))                        mS22PcieClkMask |= (1U << 10);
+  if (S22ClockEnableOne (Clock, "gcc_pcie_0_phy_rchng_clk", 100000000))            mS22PcieClkMask |= (1U << 11);
+
+  // 4. Enable PIPE clock on REF_SRC (2 = 19.2 MHz XO) BEFORE pulsing GCC_PCIE_0_BCR so the DWC
+  //    PIPE clock domain receives clock edges to exit synchronous reset cleanly!
+  MmioOr32    (0x0019C004ULL, 1U);            // GCC_PCIE_0_CLKREF_EN
+  MmioWrite32 (S22_GCC_PCIE0_PIPE_SRC, 2U);   // PHY_MUX_REF_SRC (XO)
+  if (S22ClockEnableOne (Clock, "gcc_pcie_0_pipe_clk", 0)) {
+    mS22PcieClkMask |= (1U << 12);
+  }
+  // Explicitly assert APCS voted branch enables for all 6 PCIe0 clocks + phy_rchng + clear LINK_DOWN_BCR
+  MmioOr32    (0x00162008ULL, 0x3FU);         // slv_axi, mstr_axi, cfg_ahb, aux, pipe, slv_q2a
+  MmioOr32    (0x00162000ULL, (1U << 22));    // phy_rchng
+  MmioWrite32 (0x0017C014ULL, 0U);            // GCC_PCIE_0_LINK_DOWN_BCR = 0
+  MmioWrite32 (S22_GCC_PCIE0_PIPE_SRC, 2U);   // Ensure XO while controller resets
+  gBS->Stall (500);
+
+  // Reset PCIe0 controller & PHY (with PIPE clock running on XO!), then initialize PARF
+  MmioWrite32 (S22_GCC_PCIE0_BCR, 1U);
+  MmioWrite32 (S22_GCC_PCIE0_PHY_BCR, 1U);
+  gBS->Stall (1500);
+
+  MmioWrite32 (S22_GCC_PCIE0_BCR, 0U);
+  gBS->Stall (2000);
+
+  MmioWrite32 (S22_PCIE0_PARF_BASE + 0x1000ULL, 4U); // PARF_DEVICE_TYPE = RC
+  MmioAnd32   (S22_PCIE0_PARF_BASE + 0x0040ULL, ~1U); // clear PHY_TEST_PWR_DOWN
+  MmioWrite32 (S22_PCIE0_PARF_BASE + 0x0350ULL, (UINT32)S22_PCIE0_DBI_BASE);
+  MmioWrite32 (S22_PCIE0_PARF_BASE + 0x0354ULL, 0U);
+  MmioWrite32 (S22_PCIE0_PARF_BASE + 0x0634ULL, (UINT32)S22_PCIE0_ATU_BASE);
+  MmioWrite32 (S22_PCIE0_PARF_BASE + 0x0638ULL, 0U);
+  MmioWrite32 (S22_PCIE0_PARF_BASE + 0x0358ULL, 0U);
+  MmioWrite32 (S22_PCIE0_PARF_BASE + 0x035CULL, 0x80000000U); // SLV_ADDR_SPACE_SZ
+  MmioAnd32   (S22_PCIE0_PARF_BASE + 0x0000ULL, ~(1U << 29)); // PARF_SYS_CTRL
+  MmioOr32    (S22_PCIE0_PARF_BASE + 0x0174ULL, (1U << 4));   // PARF_MHI_CLOCK_RESET_CTRL BYPASS
+  MmioAnd32   (S22_PCIE0_PARF_BASE + 0x0020ULL, ~(1U << 5));  // PARF_PM_CTRL L1/L1SS
+  MmioOr32    (S22_PCIE0_PARF_BASE + 0x01A8ULL, (1U << 31));  // PARF_AXI_MSTR_WR_ADDR_HALT_V2 EN
+
+  // 5. Initialize SM8450 QMP Gen3x1 PCIe0 PHY (exact linux-7.2.11 qmp_pcie_power_on sequence)
+  MmioWrite32 (0x0017C020ULL, 0U); // GCC_PCIE_0_NOCSR_COM_PHY_BCR deassert
+  MmioWrite32 (0x0017C028ULL, 0U); // GCC_PCIE_0_PHY_NOCSR_COM_PHY_BCR deassert
+  MmioWrite32 (S22_GCC_PCIE0_PHY_BCR, 0U);
+  gBS->Stall (1000);
+
+  MmioOr32 (S22_PCIE0_PHY_BASE + S22_QPHY_V5_PCS_POWER_DOWN_CONTROL, 0x03U);
+  for (i = 0; i < ARRAY_SIZE (mS22Pcie0PhyTbl); i++) {
+    MmioWrite32 (S22_PCIE0_PHY_BASE + mS22Pcie0PhyTbl[i].Off, mS22Pcie0PhyTbl[i].Val);
+  }
+
+  // Switch PIPE mux from XO (2) to PHY PIPE clock (0) BEFORE releasing SW_RESET and starting SerDes/PCS
+  MmioWrite32 (S22_GCC_PCIE0_PIPE_SRC, 0U);
+  gBS->Stall (200);
+
+  MmioAnd32 (S22_PCIE0_PHY_BASE + S22_QPHY_V5_PCS_SW_RESET, ~1U);
+  MmioOr32  (S22_PCIE0_PHY_BASE + S22_QPHY_V5_PCS_START_CONTROL, 0x03U);
+  gBS->Stall (1200);
+
+  for (Poll = 0; Poll < 500; Poll++) {
+    Val = MmioRead32 (S22_PCIE0_PHY_BASE + S22_QPHY_V5_PCS_PCS_STATUS1);
+    mS22PciePhyStatus = Val;
+    if ((Val & (1U << 6)) == 0U) {
+      break;
+    }
+    gBS->Stall (100);
+  }
+  mS22PciePipeSrc  = MmioRead32 (S22_GCC_PCIE0_PIPE_SRC);
+  mS22PciePipeCbcr = MmioRead32 (0x0017B03CULL);
+  mS22PcieClkRef   = MmioRead32 (0x0019C004ULL);
+  mS22PcieCmnSta   = MmioRead32 (S22_PCIE0_PHY_BASE + 0x0140ULL); // QSERDES_V5_COM_CMN_STATUS
+  mS22PcieCrdy     = MmioRead32 (S22_PCIE0_PHY_BASE + 0x0178ULL); // QSERDES_V5_COM_C_READY_STATUS
+  mS22PcieSysCtrl  = MmioRead32 (S22_PCIE0_PARF_BASE + 0x0000ULL); // PARF_SYS_CTRL
+  mS22PciePcsSta2  = MmioRead32 (S22_PCIE0_PHY_BASE + 0x0218ULL); // PCS_STATUS2
+  if ((mS22PciePhyStatus & (1U << 6)) != 0U) {
+    return;
+  }
+
+  // 6. Power on WCN6855 AFTER PHY/REFCLK is up — exact pwrseq-qcom-wcn.c wcn6855 sequence:
+  //    XO_CLK(204)=1 -> 200us -> WLAN_EN(80)=1 -> 3.5ms -> XO_CLK(204)=0 (CRITICAL!) -> 60ms settle
+  gBS->Stall (2000);
+  S22TlmmSetOutput (204, TRUE);   // xo-clk-assert (with BIT12 EGPIO APSS ownership!)
+  gBS->Stall (200);
+  mS22PcieCtl204  = MmioRead32 (S22_TLMM_BASE + 204ULL * 0x1000ULL);
+  mS22PcieIo204Hi = MmioRead32 (S22_TLMM_BASE + 204ULL * 0x1000ULL + 4ULL);
+  S22TlmmSetOutput (80, TRUE);    // wlan-enable
+  gBS->Stall (3500);              // usleep_range(2000, 5000)
+  S22TlmmSetOutput (204, FALSE);  // xo-clk-deassert (MUST drop back LOW!)
+  gBS->Stall (60000);             // pwup_delay_ms (50ms + margin)
+
+  // 7. PARF post-init, disable Hot-Plug (HPC/HPS) while keeping PCIe Root Port capability intact,
+  //    PERST# deassert (100ms T_PVPERL), & BDF-to-SID table (slot 21!)
+  MmioOr32  (S22_PCIE0_DBI_BASE + 0x8BCULL, 1U); // DBI_RO_WR_EN
+  Val = MmioRead32 (S22_PCIE0_DBI_BASE + 0x084ULL);
+  Val &= ~((1U << 5) | (1U << 6));                        // Clear HPS (BIT5) & HPC (BIT6) in SLTCAP
+  Val |= (1U << 19);                                      // Test A: restore Stage 3b SLTCAP to isolate 0xD1
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x084ULL, Val);
+  MmioAnd32 (S22_PCIE0_DBI_BASE + 0x8BCULL, ~1U);
+
+  // Deassert PERST# (GPIO 94 HIGH) after PCIE_T_PVPERL_MS (100 ms) — exact qcom_pcie_host_init order!
+  gBS->Stall (100000);
+  S22TlmmSetOutput (94, TRUE);
+  gBS->Stall (20000);
+
+  // BDF-to-SID table: 01:00.0 (BDF 0x0100) hashes to CRC8 slot 21 (verified on r0q Linux!)
+  MmioAnd32 (S22_PCIE0_PARF_BASE + 0x2C00ULL, ~1U); // Disable BDF_TO_SID bypass
+  for (i = 0; i < 256; i++) {
+    MmioWrite32 (S22_PCIE0_PARF_BASE + 0x2000ULL + (i * 4ULL), 0U);
+  }
+  MmioWrite32 (S22_PCIE0_PARF_BASE + 0x2000ULL + (21ULL * 4ULL), (0x0100U << 16) | (1U << 8));
+
+  // 8. Configure Root Port DBI (0x60000000) for Bus 0 -> Bus 1, Gen2 x1 (matching dw_pcie_setup + dw_pcie_setup_rc)
+  MmioOr32 (S22_PCIE0_DBI_BASE + 0x8BCULL, 1U); // DBI_RO_WR_EN
+
+  // CRITICAL: Reserve 0x60300000..0x603FFFFF (1 MB) for Root Port 00:00.0's own 4 KB BAR0,
+  // and set bridge memory window to 0x60400000..0x63FFFFFF (60 MB) for WCN6855 01:00.0 (2 MB BAR0)!
+  // Otherwise 00:00.0's bridge window consumes 100% of PCI0._CRS (0x60300000..0x63FFFFFF) and BAR0 hits Code 12!
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x010ULL, 0x60300000U); // RC BAR0 = 0x60300000 (4 KB)
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x014ULL, 0U);
+
+  // Interrupt pin = INTA (per dw_pcie_setup_rc)
+  Val = MmioRead32 (S22_PCIE0_DBI_BASE + 0x03CULL);
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x03CULL, (Val & 0xFFFF00FFU) | 0x00000100U);
+
+  Val = MmioRead32 (S22_PCIE0_DBI_BASE + 0x008ULL);
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x008ULL, (Val & 0xFFU) | 0x06040000U); // PCI-to-PCI bridge class
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x018ULL, 0x00010100U);                // Primary=0, Sec=1, Sub=1
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x01CULL, 0x000000F0U);                // I/O window disabled
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x020ULL, 0x63F06040U);                // Mem 0x60400000..0x63FFFFFF (leaves 0x60300000 for RC BAR0!)
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x024ULL, 0x0000FFF0U);                // Prefetchable disabled
+
+  // Test A: restore Stage 3b LnkCap (clear L0s only) to isolate 0xD1
+  Val = MmioRead32 (S22_PCIE0_DBI_BASE + 0x07CULL);
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x07CULL, (Val & ~(0xFU | (1U << 10))) | 2U);
+  Val = MmioRead32 (S22_PCIE0_DBI_BASE + 0x0A0ULL);
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x0A0ULL, (Val & ~0xFU) | 2U);
+
+  // CRITICAL (dw_pcie_setup): Set PORT_LINK_DLL_LINK_EN (BIT5), clear FAST_LINK_MODE (BIT7), set 1-lane mode (1<<16)!
+  Val = MmioRead32 (S22_PCIE0_DBI_BASE + 0x710ULL);
+  Val &= ~((1U << 7) | (0x3FU << 16));
+  Val |= (1U << 5) | (1U << 16);
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x710ULL, Val);
+
+  // 1-lane link width (GENMASK(12,8) = 0x1F<<8!) + direct speed change (BIT17)
+  Val = MmioRead32 (S22_PCIE0_DBI_BASE + 0x80CULL);
+  MmioWrite32 (S22_PCIE0_DBI_BASE + 0x80CULL, (Val & ~(0x1FU << 8)) | (1U << 8) | (1U << 17));
+
+  MmioAnd32 (S22_PCIE0_DBI_BASE + 0x8BCULL, ~1U); // DBI_RO_WR_DIS
+  MmioOr32  (S22_PCIE0_DBI_BASE + 0x004ULL, 0x0107U); // I/O + Mem + Bus Master + SERR
+
+  // Snapshot GPIO IN states: bit0=G80(WLAN_EN), bit1=G94(PERST#), bit2=G95(CLKREQ#), bit3=G204(XO_CLK), bit4=G82(SWCTRL)
+  mS22PcieGpioMask = 0;
+  if (MmioRead32 (S22_TLMM_BASE + 80ULL  * 0x1000ULL + 4ULL) & 1U) mS22PcieGpioMask |= (1U << 0);
+  if (MmioRead32 (S22_TLMM_BASE + 94ULL  * 0x1000ULL + 4ULL) & 1U) mS22PcieGpioMask |= (1U << 1);
+  if (MmioRead32 (S22_TLMM_BASE + 95ULL  * 0x1000ULL + 4ULL) & 1U) mS22PcieGpioMask |= (1U << 2);
+  if (MmioRead32 (S22_TLMM_BASE + 204ULL * 0x1000ULL + 4ULL) & 1U) mS22PcieGpioMask |= (1U << 3);
+  if (MmioRead32 (S22_TLMM_BASE + 82ULL  * 0x1000ULL + 4ULL) & 1U) mS22PcieGpioMask |= (1U << 4);
+
+  // 9. Enable LTSSM & poll link training
+  MmioOr32 (S22_PCIE0_PARF_BASE + 0x01B0ULL, (1U << 8)); // PARF_LTSSM LTSSM_EN
+
+  // On SM8450 (ops_1_9_0), real link status is in DBI PCIE_PORT_DEBUG0 (0x728) & PCIE_PORT_DEBUG1 (0x72C)!
+  // Fast 10us poll for first 40ms (catches 20us DETECT_ACT pulses), then 1ms poll up to 500ms!
+  mS22PcieSeen = 0;
+  for (Poll = 0; Poll < 4500; Poll++) {
+    UINT32 Dbg0  = MmioRead32 (S22_PCIE0_DBI_BASE + 0x728ULL);
+    UINT32 Dbg1  = MmioRead32 (S22_PCIE0_DBI_BASE + 0x72CULL);
+    UINT32 State = Dbg0 & 0x3FU;
+    mS22PcieDbg0 = Dbg0;
+    mS22PcieDbg1 = Dbg1;
+    if (State < 32U) {
+      mS22PcieSeen |= (1U << State);
+    }
+    if ((Dbg1 & (1U << 4)) != 0U && (Dbg1 & (1U << 29)) == 0U) {
+      break; // PCIE_PORT_DEBUG1_LINK_UP && !LINK_IN_TRAINING!
+    }
+    gBS->Stall ((Poll < 4000) ? 10 : 1000);
+  }
+
+  // Capture full GCC / PARF / DBI diagnostic snapshot
+  mS22PcieGdsc      = MmioRead32 (0x0017B004ULL);
+  mS22PcieVote2     = MmioRead32 (0x00162008ULL);
+  mS22PcieAuxCbcr   = MmioRead32 (0x0017B034ULL);
+  mS22PcieCfgCbcr   = MmioRead32 (0x0017B030ULL);
+  mS22PcieMstrCbcr  = MmioRead32 (0x0017B028ULL);
+  mS22PcieSlvCbcr   = MmioRead32 (0x0017B020ULL);
+  mS22PcieRchngCbcr = MmioRead32 (0x0017B044ULL);
+  mS22PcieAuxRcg    = MmioRead32 (0x0017B064ULL);
+  mS22PcieLdbcr     = MmioRead32 (0x0017C014ULL);
+  mS22PcieParfLtssm = MmioRead32 (S22_PCIE0_PARF_BASE + 0x01B0ULL);
+  mS22PcieParfPm    = MmioRead32 (S22_PCIE0_PARF_BASE + 0x0020ULL);
+  mS22PcieParfPctrl = MmioRead32 (S22_PCIE0_PARF_BASE + 0x0040ULL);
+  mS22PciePlc       = MmioRead32 (S22_PCIE0_DBI_BASE + 0x0710ULL);
+  mS22PcieLwsc      = MmioRead32 (S22_PCIE0_DBI_BASE + 0x080CULL);
+
+  // 10. Program iATU Outbound Region 0 (ECAM CFG0 Bus 1 Dev 0 Func 0 ONLY: 4 KB = 0x60100000..0x60100FFF!)
+  //     CRITICAL: Limiting to 0x00FFF prevents 01:01.0..01:1F.0 from aliasing WCN6855 (which gave ep1=0x110317CB
+  //     and caused Windows pci.sys to spawn 32 duplicate copies of qcwlan8280.sys!).
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x008ULL, (UINT32)S22_PCIE0_CFG1_BASE);
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x00CULL, 0U);
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x010ULL, (UINT32)(S22_PCIE0_CFG1_BASE + 0x00FFFU));
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x020ULL, 0U);
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x014ULL, 0U);
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x018ULL, 0U);
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x000ULL, 0x04U); // PCIE_ATU_TYPE_CFG0
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x004ULL, (1U << 31) | (1U << 28)); // ENABLE | CFG_SHIFT_MODE
+  for (Poll = 0; Poll < 50; Poll++) {
+    if ((MmioRead32 (S22_PCIE0_ATU_BASE + 0x004ULL) & (1U << 31)) != 0U) break;
+    gBS->Stall (100);
+  }
+  mS22PcieAuxRcg = MmioRead32 (S22_PCIE0_ATU_BASE + 0x010ULL); // Reuse field to verify actual iATU Limit readback!
+
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x208ULL, (UINT32)S22_PCIE0_MEM_BASE);
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x20CULL, 0U);
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x210ULL, (UINT32)S22_PCIE0_MEM_LIMIT);
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x220ULL, 0U);
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x214ULL, (UINT32)S22_PCIE0_MEM_BASE);
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x218ULL, 0U);
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x200ULL, 0x00U); // PCIE_ATU_TYPE_MEM
+  MmioWrite32 (S22_PCIE0_ATU_BASE + 0x204ULL, (1U << 31)); // ENABLE
+  for (Poll = 0; Poll < 50; Poll++) {
+    if ((MmioRead32 (S22_PCIE0_ATU_BASE + 0x204ULL) & (1U << 31)) != 0U) break;
+    gBS->Stall (100);
+  }
+
+  // 11. Probe Root Port + Endpoint IDs (only read Bus 1 / Dev 1 if LINK_UP is asserted)
+  mS22PcieRpId   = MmioRead32 (S22_PCIE0_DBI_BASE + 0x0000ULL);
+  mS22PcieLnkSta = MmioRead32 (S22_PCIE0_DBI_BASE + 0x0080ULL);
+  if ((mS22PcieDbg1 & (1U << 4)) != 0U) {
+    gBS->Stall (10000);
+    mS22PcieEpId    = MmioRead32 (S22_PCIE0_CFG1_BASE + 0x0000ULL);
+    mS22PcieEp1Id   = MmioRead32 (S22_PCIE0_CFG1_BASE + 0x8000ULL);
+    mS22PcieEpBar0  = MmioRead32 (S22_PCIE0_CFG1_BASE + 0x0010ULL);
+    mS22PcieSlvCbcr = MmioRead32 (S22_PCIE0_CFG1_BASE + 0x003CULL); // WCN6855 InterruptLine/Pin
+    mS22PcieDev1Id  = MmioRead32 (S22_PCIE0_DBI_BASE + 0x8000ULL);
+  }
+  mS22GicdCtlr  = MmioRead32 (0x17100000ULL);
+  mS22GicdTyper = MmioRead32 (0x17100004ULL);
+  mS22SmmuCr0   = MmioRead32 (0x15000000ULL);
+  mS22SmmuIdr0  = MmioRead32 (0x15000020ULL);
+  mS22SmmuGfsr  = MmioRead32 (0x15000048ULL);
+
+  // 12. Configure apps_smmu (0x15000000) hardware BYPASS for PCIe0 SIDs 0x1C00 (RC) & 0x1C01 (WCN6855)!
+  //     CRITICAL: SM8450 QHEE leaves sCR0=0x2B0406 (CLIENTPD=0, USFCFG=1 = Unidentified Stream Fault!),
+  //     which hard-resets the SoC on WCN6855's very first DMA/MSI TLP unless SID 0x1C00/0x1C01 has a valid SMR+S2CR!
+  //     Uses exact Linux arm-smmu-qcom.c bypass_quirk detection (emulate bypass via CB[num_cb-1] SCTLR=0 if needed).
+  {
+    CONST UINT64 SmmuBase = 0x15000000ULL;
+    UINT32       Idr1     = MmioRead32 (SmmuBase + 0x24ULL);
+    UINT32       NumSmrg  = mS22SmmuIdr0 & 0xFFU;
+    UINT32       NumCb    = Idr1 & 0xFFU;
+    UINT32       PgShift  = (Idr1 & (1U << 31)) ? 16U : 12U;
+    UINT32       NumPage  = 1U << (((Idr1 >> 28) & 0x7U) + 1U);
+    UINT32       Slot     = 0xFFFFFFFFU;
+    INT32        Idx;
+
+    if (NumSmrg > 128U) {
+      NumSmrg = 128U;
+    }
+    // Check ALL existing valid SMRs independently for BOTH 0x1C00 and 0x1C01
+    {
+      BOOLEAN Has1C00 = FALSE;
+      BOOLEAN Has1C01 = FALSE;
+      for (Idx = 0; Idx < (INT32)NumSmrg; Idx++) {
+        UINT32 CurSmr = MmioRead32 (SmmuBase + 0x800ULL + ((UINT64)Idx * 4ULL));
+        if ((CurSmr & (1U << 31)) != 0U) {
+          UINT32 CurMask = (CurSmr >> 16) & 0x7FFFU;
+          UINT32 CurId   = CurSmr & 0x7FFFU;
+          if ((0x1C00U & ~CurMask) == (CurId & ~CurMask)) Has1C00 = TRUE;
+          if ((0x1C01U & ~CurMask) == (CurId & ~CurMask)) Has1C01 = TRUE;
+        }
+      }
+      if (!Has1C00 && !Has1C01) {
+        for (Idx = (INT32)NumSmrg - 1; Idx >= 0; Idx--) {
+          if ((MmioRead32 (SmmuBase + 0x800ULL + ((UINT64)Idx * 4ULL)) & (1U << 31)) == 0U) {
+            Slot = (UINT32)Idx;
+            break;
+          }
+        }
+      }
+    }
+
+    if (Slot != 0xFFFFFFFFU && NumCb > 0U) {
+      UINT64 S2crAddr = SmmuBase + 0xC00ULL + ((UINT64)Slot * 4ULL);
+      UINT64 SmrAddr  = SmmuBase + 0x800ULL + ((UINT64)Slot * 4ULL);
+      UINT32 S2crVal;
+
+      // Probe raw S2CR_TYPE_BYPASS (1 << 16)
+      MmioWrite32 (S2crAddr, (1U << 16) | 0xFFU);
+      S2crVal = MmioRead32 (S2crAddr);
+      if (((S2crVal >> 16) & 0x3U) != 1U) {
+        // qcom_smmu bypass_quirk active: reserve last context bank (NumCb - 1) with SCTLR=0 (Stage-1 disabled = bypass!)
+        UINT32 CbIdx    = NumCb - 1U;
+        UINT64 Gr1Cbar  = SmmuBase + (1ULL << PgShift) + ((UINT64)CbIdx * 4ULL);
+        UINT64 CbSctlr  = SmmuBase + (((UINT64)NumPage + (UINT64)CbIdx) << PgShift);
+        MmioWrite32 (CbSctlr, 0U);            // ARM_SMMU_CB_SCTLR = 0 (MMU disabled -> 1:1 bypass)
+        MmioWrite32 (Gr1Cbar, (1U << 16));    // CBAR_TYPE_S1_TRANS_S2_BYPASS
+        MmioWrite32 (S2crAddr, CbIdx & 0xFFU); // S2CR_TYPE_TRANS (0<<16) | CbIdx
+      }
+      MemoryFence ();
+      // Enable SMR[Slot]: VALID(BIT31) | MASK=0x0001(bits 30:16) | ID=0x1C00(bits 15:0) -> matches 0x1C00 & 0x1C01!
+      MmioWrite32 (SmrAddr, (1U << 31) | (0x0001U << 16) | 0x1C00U);
+      MemoryFence ();
+
+      mS22SmmuS2cr = MmioRead32 (S2crAddr);
+      mS22SmmuSmr  = MmioRead32 (SmrAddr);
+    }
+  }
+
+  // 13. Arm DesignWare PCIe0 Integrated MSI Receiver (iMSI-RX) for APIC 0x0D MSI Frame @ 0x17100000!
+  //     Ensure PARF_INT_ALL_MASK (0x22C) allows MSI interrupts (BIT13 | GENMASK(30,23)).
+  {
+    UINT32 Bank;
+    MmioOr32 (S22_PCIE0_PARF_BASE + 0x022CULL, 0x7F802000U);
+    MmioWrite32 (S22_PCIE0_DBI_BASE + 0x820ULL, 0x17100040U); // PCIE_MSI_ADDR_LO
+    MmioWrite32 (S22_PCIE0_DBI_BASE + 0x824ULL, 0x00000000U); // PCIE_MSI_ADDR_HI
+    for (Bank = 0; Bank < 8U; Bank++) {
+      UINT64 Off = (UINT64)Bank * 0x0CULL;
+      MmioWrite32 (S22_PCIE0_DBI_BASE + 0x830ULL + Off, 0xFFFFFFFFU); // clear stale STATUS
+      MmioWrite32 (S22_PCIE0_DBI_BASE + 0x82CULL + Off, 0x00000000U); // unmask all
+      MmioWrite32 (S22_PCIE0_DBI_BASE + 0x828ULL + Off, 0xFFFFFFFFU); // enable all
+    }
+    mS22PcieLdbcr    = MmioRead32 (S22_PCIE0_DBI_BASE + 0x820ULL);
+    mS22PcieRchngCbcr = MmioRead32 (S22_PCIE0_PARF_BASE + 0x022CULL);
+  }
+}
+
+STATIC
+VOID
+S22FlushPcieLog (
+  VOID
+  )
+{
+  EFI_STATUS  Status;
+  UINTN       HandleCount = 0;
+  EFI_HANDLE  *Handles    = NULL;
+  UINTN       Index;
+  CHAR8       LogBuf[512];
+  UINTN       LogLen;
+
+  if (mS22PcieLogWritten) {
+    return;
+  }
+
+  LogLen = AsciiSPrint (
+             LogBuf,
+             sizeof (LogBuf),
+             "g=0x%x c204=0x%x io204=0x%x phy=0x%x p2=0x%x cmn=0x%x crdy=0x%x seen=0x%x d0=0x%x d1=0x%x ls=0x%x rp=0x%08x ep=0x%08x ep1=0x%08x dev1=0x%08x\r\n"
+             "gdsc=0x%x v2=0x%x aux=0x%x cfg=0x%x mstr=0x%x slv=0x%x rchng=0x%x auxrcg=0x%x ldb=0x%x ltssm=0x%x pm=0x%x pctrl=0x%x plc=0x%x lwsc=0x%x gicdc=0x%x gicdt=0x%x smmu=0x%x/0x%x/0x%x/%x/%x\r\n",
+             mS22PcieGpioMask,
+             mS22PcieCtl204,
+             mS22PcieIo204Hi,
+             mS22PciePhyStatus,
+             mS22PciePcsSta2,
+             mS22PcieCmnSta,
+             mS22PcieCrdy,
+             mS22PcieSeen,
+             mS22PcieDbg0,
+             mS22PcieDbg1,
+             mS22PcieLnkSta,
+             mS22PcieRpId,
+             mS22PcieEpId,
+             mS22PcieEp1Id,
+             mS22PcieDev1Id,
+             mS22PcieGdsc,
+             mS22PcieVote2,
+             mS22PcieAuxCbcr,
+             mS22PcieCfgCbcr,
+             mS22PcieMstrCbcr,
+             mS22PcieSlvCbcr,
+             mS22PcieRchngCbcr,
+             mS22PcieAuxRcg,
+             mS22PcieLdbcr,
+             mS22PcieParfLtssm,
+             mS22PcieParfPm,
+             mS22PcieParfPctrl,
+             mS22PciePlc,
+             mS22PcieLwsc,
+             mS22GicdCtlr,
+             mS22GicdTyper,
+             mS22SmmuCr0,
+             mS22SmmuIdr0,
+             mS22SmmuGfsr,
+             mS22SmmuS2cr,
+             mS22SmmuSmr
+             );
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiSimpleFileSystemProtocolGuid,
+                  NULL,
+                  &HandleCount,
+                  &Handles
+                  );
+  if (EFI_ERROR (Status) || Handles == NULL || HandleCount == 0) {
+    return;
+  }
+
+  for (Index = 0; Index < HandleCount; Index++) {
+    EFI_SIMPLE_FILE_SYSTEM_PROTOCOL  *Fs     = NULL;
+    EFI_FILE_PROTOCOL                *Root   = NULL;
+    EFI_FILE_PROTOCOL                *EfiDir = NULL;
+    EFI_FILE_PROTOCOL                *S22Dir = NULL;
+    EFI_FILE_PROTOCOL                *File   = NULL;
+
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiSimpleFileSystemProtocolGuid, (VOID **)&Fs)) || Fs == NULL) {
+      continue;
+    }
+    if (EFI_ERROR (Fs->OpenVolume (Fs, &Root)) || Root == NULL) {
+      continue;
+    }
+
+    // Only write to the ESP (the FAT32 volume that already contains \EFI)
+    if (!EFI_ERROR (Root->Open (Root, &EfiDir, L"EFI", EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE, 0)) && EfiDir != NULL) {
+      if (!EFI_ERROR (EfiDir->Open (EfiDir, &S22Dir, L"S22", EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE | EFI_FILE_MODE_CREATE, EFI_FILE_DIRECTORY)) && S22Dir != NULL) {
+        if (!EFI_ERROR (S22Dir->Open (S22Dir, &File, L"pcie_log.txt", EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE | EFI_FILE_MODE_CREATE, 0)) && File != NULL) {
+          UINTN WriteLen = LogLen;
+          File->SetPosition (File, 0);
+          File->Write (File, &WriteLen, LogBuf);
+          File->Flush (File);
+          File->Close (File);
+          mS22PcieLogWritten = TRUE;
+        }
+        S22Dir->Close (S22Dir);
+      }
+      EfiDir->Close (EfiDir);
+      Root->Close (Root);
+      break;
+    }
+
+    Root->Close (Root);
+  }
+
+  FreePool (Handles);
+}
+
+STATIC
+VOID
+S22CheckRebootTwrpFlag (
+  VOID
+  )
+{
+  EFI_STATUS                       Status;
+  UINTN                            HandleCount = 0;
+  EFI_HANDLE                       *Handles    = NULL;
+  UINTN                            Index;
+
+  Status = gBS->LocateHandleBuffer (
+                  ByProtocol,
+                  &gEfiSimpleFileSystemProtocolGuid,
+                  NULL,
+                  &HandleCount,
+                  &Handles
+                  );
+  if (EFI_ERROR (Status) || Handles == NULL || HandleCount == 0) {
+    return;
+  }
+
+  for (Index = 0; Index < HandleCount; Index++) {
+    EFI_SIMPLE_FILE_SYSTEM_PROTOCOL  *Fs   = NULL;
+    EFI_FILE_PROTOCOL                *Root = NULL;
+    EFI_FILE_PROTOCOL                *File = NULL;
+
+    if (EFI_ERROR (gBS->HandleProtocol (Handles[Index], &gEfiSimpleFileSystemProtocolGuid, (VOID **)&Fs)) || Fs == NULL) {
+      continue;
+    }
+    if (EFI_ERROR (Fs->OpenVolume (Fs, &Root)) || Root == NULL) {
+      continue;
+    }
+
+    Status = Root->Open (
+                     Root,
+                     &File,
+                     L"\\EFI\\S22\\reboot_twrp.flag",
+                     EFI_FILE_MODE_READ | EFI_FILE_MODE_WRITE,
+                     0
+                     );
+    if (!EFI_ERROR (Status) && File != NULL) {
+      EFI_QCOM_PMIC_PON_PROTOCOL  *PmicPon   = NULL;
+      S22_SPMI_PROTOCOL           *Spmi      = NULL;
+      UINT8                       SdamVal    = 0;
+      UINT32                      BytesRead  = 0;
+
+      // Always delete the one-shot flag BEFORE rebooting so it never loops
+      File->Delete (File);
+      Root->Close (Root);
+      FreePool (Handles);
+
+      // Samsung Galaxy S22 (r0q / PMK8350) ABL reads reboot_reason from PMK8350 SDAM_2 @ 0x7148 bits[7:1]
+      // Verified from pmk8350.dtsi & s22-linux/docs/boot-log.md: mode-recovery = 0x01 -> (0x01 << 1) = 0x02
+      Status = gBS->LocateProtocol (&gS22SpmiProtocolGuid, NULL, (VOID **)&Spmi);
+      if (!EFI_ERROR (Status) && Spmi != NULL && Spmi->ReadLong != NULL && Spmi->WriteLong != NULL) {
+        (VOID)Spmi->ReadLong (Spmi, 0, 0, 0, 0x7148, &SdamVal, 1, &BytesRead);
+        SdamVal = (UINT8)((SdamVal & 0x01U) | 0x02U);
+        (VOID)Spmi->WriteLong (Spmi, 0, 0, 0, 0x7148, &SdamVal, 1);
+      }
+
+      // Also set PON SOFT_SPARE as secondary fallback
+      Status = gBS->LocateProtocol (&gQcomPmicPonProtocolGuid, NULL, (VOID **)&PmicPon);
+      if (!EFI_ERROR (Status) && PmicPon != NULL && PmicPon->SetSpareReg != NULL) {
+        PmicPon->SetSpareReg (0, EFI_PM_PON_SOFT_SPARE, 0x02, 0xFE);
+      }
+
+      gBS->Stall (100000);
+      // Clean warm reset WITHOUT RESET_PARAM override so SDAM 0x7148 stays 0x02 for Samsung ABL -> TWRP!
+      gRT->ResetSystem (EfiResetWarm, EFI_SUCCESS, 0, NULL);
+      gRT->ResetSystem (EfiResetCold, EFI_SUCCESS, 0, NULL);
+      return;
+    }
+
+    Root->Close (Root);
+  }
+
+  FreePool (Handles);
+}
+
+STATIC
+VOID
+EFIAPI
+S22UsbOtgTimerCallback (
+  IN EFI_EVENT  Event,
+  IN VOID       *Context
+  )
+{
+  S22CheckRebootTwrpFlag ();
+  S22FlushPcieLog ();
+  S22ConfigureMax77705OtgAndMuic ();
+  S22ForceDwc3HostRegs ();
+}
+
+STATIC
+VOID
+S22PrepareUsbHost (
+  VOID
+  )
+{
+  EFI_STATUS               Status;
+  S22_USB_CONFIG_PROTOCOL  *UsbCfg = NULL;
+
+  // 1. Configure MAX77705 OTG 5V/1500mA boost AND route MUIC D+/D- to AP_USB (Opcode 0x06 = 0x09)
+  S22ConfigureMax77705OtgAndMuic ();
+  gBS->Stall (20000);
+
+  // 2. Start USB Core 0 in native Host Mode (ModeType = 1 = USB_HOST_MODE_XHCI) via UsbConfigDxe
+  Status = gBS->LocateProtocol (&gS22UsbConfigProtocolGuid, NULL, (VOID **)&UsbCfg);
+  if (!EFI_ERROR (Status) && UsbCfg != NULL && UsbCfg->StartController != NULL) {
+    (VOID)UsbCfg->StartController (UsbCfg, 0, 1); // Core 0, USB_HOST_MODE_XHCI (1)
+    gBS->Stall (100000);
+  }
+
+  // 3. Re-apply MUIC D+/D- switch & DWC3 Host regs after UsbConfigDxe init
+  S22ConfigureMax77705OtgAndMuic ();
+  S22ForceDwc3HostRegs ();
+
+  // 4. Keep a 2-second periodic timer during UEFI Boot Manager so hot-plugging OTG hub during
+  //    the 15s countdown re-closes MUIC D+/D- (0x06, 0x09) and enables 5V OTG boost
+  if (mS22UsbOtgTimerEvent == NULL) {
+    Status = gBS->CreateEvent (
+                    EVT_TIMER | EVT_NOTIFY_SIGNAL,
+                    TPL_CALLBACK,
+                    S22UsbOtgTimerCallback,
+                    NULL,
+                    &mS22UsbOtgTimerEvent
+                    );
+    if (!EFI_ERROR (Status)) {
+      (VOID)gBS->SetTimer (mS22UsbOtgTimerEvent, TimerPeriodic, 10000000ULL); // 1s in 100ns units
+    }
+  }
+}
