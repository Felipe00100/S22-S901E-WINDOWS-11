+STATIC
+VOID
+S22TlmmSetOutput (
+  IN UINT32   Gpio,
+  IN BOOLEAN  High
+  )
+{
+  UINT64 CtlAddr   = S22_TLMM_BASE + ((UINT64)Gpio * 0x1000ULL);
+  UINT32 Ctl       = MmioRead32 (CtlAddr);
+  // CRITICAL (pinctrl-msm.c / pinctrl-sm8450.c): GPIO 204 (XO_CLK) has egpio_present (BIT11)=1.
+  // APSS TLMM MUST set egpio_enable (BIT12)=1 to claim pin ownership from EGPIO/AOP!
+  UINT32 EgpioBits = (Ctl & (1U << 11)) ? ((1U << 11) | (1U << 12)) : 0U;
+
+  // Set output value BEFORE enabling OE
+  // Drive strength 16 mA (7 << 6) matching sm8450-samsung-r0q.dts wlan_en / xo_clk_default
+  MmioWrite32 (CtlAddr + 4ULL, High ? 2U : 0U);
+  Ctl = EgpioBits | (1U << 9) | (7U << 6); // OE=1, 16mA drive, func=0, no-pull
+  MmioWrite32 (CtlAddr, Ctl);
+}
+
+STATIC
+VOID
+S22TlmmSetFunc (
+  IN UINT32  Gpio,
+  IN UINT32  Func,
+  IN UINT32  Pull
+  )
+{
+  UINT64 CtlAddr   = S22_TLMM_BASE + ((UINT64)Gpio * 0x1000ULL);
+  UINT32 Ctl       = MmioRead32 (CtlAddr);
+  UINT32 EgpioBits = (Ctl & (1U << 11)) ? ((1U << 11) | (1U << 12)) : 0U;
+
+  Ctl = EgpioBits | ((Func & 0xFU) << 2) | (Pull & 0x3U);
+  MmioWrite32 (CtlAddr, Ctl);
+}
