+STATIC UINT32 mS22PcieRailsMask = 0;
+
+STATIC
+VOID
+S22EnableTouchRails (
+  VOID
+  )
+{
+  EFI_STATUS           Status;
+  S22_CMD_DB_PROTOCOL  *CmdDb  = NULL;
+  S22_RPMH_PROTOCOL    *Rpmh   = NULL;
+  VOID                 *Handle = NULL;
+  CONST UINT32         DrvId   = 2; // Verified from r0q RpmhDxe.efi DRV table (count=1, drv_id=0x2 = RSC_DRV_HLOS)
+  BOOLEAN              Valid   = FALSE;
+
+  Status = gBS->LocateProtocol (&gS22CmdDbProtocolGuid, NULL, (VOID **)&CmdDb);
+  if (EFI_ERROR (Status) || CmdDb == NULL) {
+    DEBUG ((EFI_D_ERROR, "S22TouchRails: CmdDb protocol not found (%r)\n", Status));
+    return;
+  }
+
+  Status = gBS->LocateProtocol (&gS22RpmhProtocolGuid, NULL, (VOID **)&Rpmh);
+  if (EFI_ERROR (Status) || Rpmh == NULL) {
+    DEBUG ((EFI_D_ERROR, "S22TouchRails: Rpmh protocol not found (%r)\n", Status));
+    return;
+  }
+
+  Status = Rpmh->IsDrvIdValid (DrvId, &Valid);
+  if (EFI_ERROR (Status) || !Valid) {
+    DEBUG ((EFI_D_ERROR, "S22TouchRails: RPMh DRV_ID %u invalid (%r, valid=%u)\n", DrvId, Status, Valid));
+    return;
+  }
+
+  Status = Rpmh->CreateHandle (DrvId, "s22_tsp", &Handle);
+  if (EFI_ERROR (Status) || Handle == NULL) {
+    DEBUG ((EFI_D_ERROR, "S22TouchRails: CreateHandle(drv=%u) failed (%r)\n", DrvId, Status));
+    return;
+  }
+
+  // Enable VDD (1.8 V) then AVDD (3.0 V) per Samsung r0q fts2ba61y sequence
+  Status = S22EnableVrmLdo (CmdDb, Rpmh, Handle, "ldoc8",  "l8c",  1800);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((EFI_D_ERROR, "S22TouchRails: VDD ldoc8 enable failed (%r), skipping AVDD\n", Status));
+    return;
+  }
+
+  gBS->Stall (5000);
+  Status = S22EnableVrmLdo (CmdDb, Rpmh, Handle, "ldoc11", "l11c", 3000);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((EFI_D_ERROR, "S22TouchRails: AVDD ldoc11 enable failed (%r)\n", Status));
+    return;
+  }
+
+  // Also ensure SM8450 USB2 HS PHY & QMP USB3 SS PHY + PCIe0 PHY + WCN6855 rails stay powered on (from sm8450-samsung-r0q.dts + wifirails.c)
+  mS22PcieRailsMask = 0;
+  if (!EFI_ERROR (S22EnableVrmLdo (CmdDb, Rpmh, Handle, "ldob5", "l5b", 888)))  mS22PcieRailsMask |= (1U << 0);
+  (VOID)S22EnableVrmLdo (CmdDb, Rpmh, Handle, "ldoc1", "l1c", 1800);
+  (VOID)S22EnableVrmLdo (CmdDb, Rpmh, Handle, "ldob2", "l2b", 3072);
+  (VOID)S22EnableVrmLdo (CmdDb, Rpmh, Handle, "ldob1", "l1b", 912);
+  if (!EFI_ERROR (S22EnableVrmLdo (CmdDb, Rpmh, Handle, "ldob6",  "l6b",  1200))) mS22PcieRailsMask |= (1U << 1);
+  if (!EFI_ERROR (S22EnableVrmLdo (CmdDb, Rpmh, Handle, "smpb10", "s10b", 1800))) mS22PcieRailsMask |= (1U << 2);
+  if (!EFI_ERROR (S22EnableVrmLdo (CmdDb, Rpmh, Handle, "smpb11", "s11b",  980))) mS22PcieRailsMask |= (1U << 3);
+  if (!EFI_ERROR (S22EnableVrmLdo (CmdDb, Rpmh, Handle, "smpb12", "s12b", 1352))) mS22PcieRailsMask |= (1U << 4);
+  if (!EFI_ERROR (S22EnableVrmLdo (CmdDb, Rpmh, Handle, "smpe2",  "s2e",  1012))) mS22PcieRailsMask |= (1U << 5);
+  if (!EFI_ERROR (S22EnableVrmLdo (CmdDb, Rpmh, Handle, "smpc1",  "s1c",  1904))) mS22PcieRailsMask |= (1U << 6);
+  (VOID)S22EnableVrmLdo (CmdDb, Rpmh, Handle, "ldoe7",  "l7e",  2800); // WLAN/BT antenna switch (stock pmr735a_l7)
+
+  gBS->Stall (15000);
+}
