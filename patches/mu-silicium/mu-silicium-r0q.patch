++STATIC
++VOID
++DrawAutoBootCountdown (
++  IN BOOT_MENU_POPUP_DATA  *BootMenuData,
++  IN UINTN                 SecondsLeft
++  )
++{
++  CHAR16  StatusLine[80];
++  UINTN   SavedAttribute;
++  UINTN   Row;
++  UINTN   Col;
++  UINTN   MaxCol;
++  UINTN   MaxRow;
++  UINTN   Len;
++
