+STATIC
+EFI_STATUS
+S22EnableVrmLdo (
+  IN S22_CMD_DB_PROTOCOL  *CmdDb,
+  IN S22_RPMH_PROTOCOL    *Rpmh,
+  IN VOID                 *Handle,
+  IN CONST CHAR8          *PrimaryName,
+  IN CONST CHAR8          *FallbackName,
+  IN UINT32               VoltageMv
+  )
+{
+  EFI_STATUS            Status;
+  UINT32                BaseAddr = 0;
+  UINT32                ReqId    = 0;
+  S22_RPMH_COMMAND_SET  CmdSet;
+
+  Status = CmdDb->QueryAddr (CmdDb, PrimaryName, &BaseAddr);
+  if ((EFI_ERROR (Status) || BaseAddr == 0) && FallbackName != NULL) {
+    BaseAddr = 0;
+    Status = CmdDb->QueryAddr (CmdDb, FallbackName, &BaseAddr);
+  }
+
+  if (EFI_ERROR (Status) || BaseAddr == 0) {
+    DEBUG ((EFI_D_ERROR, "S22TouchRails: cmd-db lookup failed for %a (%r, addr=0x%x)\n", PrimaryName, Status, BaseAddr));
+    return EFI_NOT_FOUND;
+  }
+
+  // VRM offsets: +0x0 = VOLTAGE (mV), +0x4 = ENABLE (0/1), +0x8 = MODE (7 = PMIC5 HPM)
+  CmdSet.Set         = 0; // RPMH_SET_ACTIVE
+  CmdSet.NumCommands = 3;
+  CmdSet.Reserved    = 0;
+
+  CmdSet.Commands[0].Address    = BaseAddr + 0x0;
+  CmdSet.Commands[0].Data       = VoltageMv;
+  CmdSet.Commands[0].Completion = 1;
+
+  CmdSet.Commands[1].Address    = BaseAddr + 0x8;
+  CmdSet.Commands[1].Data       = 7; // PMIC5 LDO HPM
+  CmdSet.Commands[1].Completion = 1;
+
+  CmdSet.Commands[2].Address    = BaseAddr + 0x4;
+  CmdSet.Commands[2].Data       = 1; // ENABLE
+  CmdSet.Commands[2].Completion = 1;
+
+  Status = Rpmh->IssueCommandSet (Handle, &CmdSet, &ReqId);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((EFI_D_ERROR, "S22TouchRails: IssueCommandSet(%a, 0x%x) failed (%r)\n", PrimaryName, BaseAddr, Status));
+    return Status;
+  }
+
+  if (ReqId != 0) {
+    Status = Rpmh->ChurnAll (Handle, ReqId);
+    if (EFI_ERROR (Status)) {
+      DEBUG ((EFI_D_ERROR, "S22TouchRails: ChurnAll(%a, req=%u) failed (%r)\n", PrimaryName, ReqId, Status));
+      return Status;
+    }
+  }
+
+  DEBUG ((EFI_D_WARN, "S22TouchRails: %a (0x%x) -> %u mV ON (Status=%r, ReqId=%u)\n",
+          PrimaryName, BaseAddr, VoltageMv, Status, ReqId));
+  return EFI_SUCCESS;
+}
