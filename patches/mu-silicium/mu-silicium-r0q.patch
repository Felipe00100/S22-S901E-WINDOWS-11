+STATIC
+VOID
+S22ForceDwc3HostRegs (
+  VOID
+  )
+{
+  UINT32 SnpsId = MmioRead32 (0x0A60C120ULL);
+  if ((SnpsId & 0xFFFF0000U) == 0x55330000U) {
+    UINT32 Gctl   = MmioRead32 (0x0A60C110ULL);
+    UINT32 HsCtrl = MmioRead32 (0x0A6F8810ULL);
+    UINT32 SsCtrl = MmioRead32 (0x0A6F8830ULL);
+
+    Gctl = (Gctl & ~(3U << 12)) | (1U << 12); // DWC3_GCTL_PRTCAP_HOST
+    MmioWrite32 (0x0A60C110ULL, Gctl);
+
+    // Clear QSCRATCH peripheral VBUS override bits (UTMI_OTG_VBUS_VALID bit 20 | SW_SESSVLD_SEL bit 28)
+    HsCtrl &= ~((1U << 20) | (1U << 28));
+    MmioWrite32 (0x0A6F8810ULL, HsCtrl);
+
+    // Clear QSCRATCH SS_PHY_CTRL LANE0_PWR_PRESENT (bit 24)
+    SsCtrl &= ~(1U << 24);
+    MmioWrite32 (0x0A6F8830ULL, SsCtrl);
+  }
+}
