+STATIC UINT32     mS22Max77705I2cInst  = 0;
+STATIC EFI_EVENT  mS22UsbOtgTimerEvent = NULL;
+
+STATIC
+VOID
+S22ConfigureMax77705OtgAndMuic (
+  VOID
+  )
+{
+  EFI_STATUS             Status;
+  EFI_QCOM_I2C_PROTOCOL  *I2c = NULL;
+  UINT32                 Inst, StartInst, EndInst;
+  i2c_slave_config       Cfg;
+  UINT8                  Buf2[2];
+  UINT8                  IntOk    = 0;
+  UINT8                  Cnfg00   = 0;
+  UINT8                  Cnfg02   = 0;
+  UINT8                  Cc0      = 0;
+  UINT8                  OpCmd[2] = { 0x06, 0x09 }; // MAX77705_OP_CTRL1_W (0x06) = COM_USB_AP (0x09)
+  UINT8                  OpEnd    = 0x00;
+  UINT32                 Xfer     = 0;
+
+  Status = gBS->LocateProtocol (&gQcomI2CProtocolGuid, NULL, (VOID **)&I2c);
+  if (EFI_ERROR (Status) || I2c == NULL || I2c->open == NULL || I2c->read == NULL || I2c->write == NULL) {
+    return;
+  }
+
+  ZeroMem (&Cfg, sizeof (Cfg));
+  Cfg.bus_frequency_khz          = 400;
+  Cfg.mode                       = I2C;
+  Cfg.slave_max_clock_stretch_us = 500;
+
+  StartInst = (mS22Max77705I2cInst != 0) ? mS22Max77705I2cInst : (UINT32)I2C_INSTANCE_001;
+  EndInst   = (mS22Max77705I2cInst != 0) ? mS22Max77705I2cInst : (UINT32)I2C_INSTANCE_024;
+
+  for (Inst = StartInst; Inst <= EndInst; Inst++) {
+    VOID *Handle = NULL;
+    if (I2c->open ((i2c_instance)Inst, &Handle) != I2C_SUCCESS || Handle == NULL) {
+      continue;
+    }
+
+    if (mS22Max77705I2cInst == 0) {
+      Cfg.slave_address = 0x36; // Fuel gauge probe
+      ZeroMem (Buf2, sizeof (Buf2));
+      if (I2c->read (Handle, &Cfg, 0x09, 1, Buf2, 2, &Xfer, 500) == I2C_SUCCESS) {
+        UINT16 Raw16 = (UINT16)(Buf2[0] | ((UINT16)Buf2[1] << 8));
+        UINT32 Mv    = (UINT32)(((UINT64)(Raw16 >> 3) * 625ULL) / 1000ULL);
+        if (Mv >= 2000 && Mv <= 4800) {
+          mS22Max77705I2cInst = Inst;
+        }
+      }
+    }
+
+    if (mS22Max77705I2cInst == Inst) {
+      // 1. Route MAX77705 USBC/MUIC (0x25) D+/D- analog switch to AP_USB (Opcode 0x06, Val 0x09)
+      Cfg.slave_address = 0x25;
+      I2c->write (Handle, &Cfg, 0x21, 1, OpCmd, 2, &Xfer, 500);
+      I2c->write (Handle, &Cfg, 0x41, 1, &OpEnd, 1, &Xfer, 500);
+
+      // 2. Check CC_STATUS0 (0x0A) for CC1/CC2 orientation on QMP Combo PHY (0x088E8010)
+      if (I2c->read (Handle, &Cfg, 0x0A, 1, &Cc0, 1, &Xfer, 500) == I2C_SUCCESS) {
+        UINT8 CcPin = (Cc0 >> 6) & 0x03U;
+        if (CcPin == 1 || CcPin == 2) {
+          UINT32 TypecCtrl = (CcPin == 2) ? 0x03U : 0x02U; // SW_PORTSELECT_MUX | (CC2 ? SW_PORTSELECT_VAL : 0)
+          MmioWrite32 (0x088E8010ULL, TypecCtrl);
+        }
+      }
+
+      // 3. Enable OTG 5V/1500mA boost on Charger (0x69) if no external charger VBUS
+      Cfg.slave_address = 0x69;
+      if (I2c->read (Handle, &Cfg, 0xB2, 1, &IntOk, 1, &Xfer, 500) == I2C_SUCCESS &&
+          (IntOk & (1U << 6)) == 0)
+      {
+        UINT8 Cnfg06 = 0x0D;
+        // Unlock charger registers (CHG_CNFG_06 0xBD: CHGPROT=11 [0x0C], WDTCLR=01, DIS_AICL=0)
+        if (I2c->read (Handle, &Cfg, 0xBD, 1, &Cnfg06, 1, &Xfer, 500) == I2C_SUCCESS) {
+          Cnfg06 = (UINT8)((Cnfg06 & ~0x1FU) | 0x0DU);
+        }
+        I2c->write (Handle, &Cfg, 0xBD, 1, &Cnfg06, 1, &Xfer, 500);
+
+        // Set OTG boost current limit to 1500 mA (CHG_CNFG_02 0xB9 bits[7:6] = 11 -> 0xC0)
+        if (I2c->read (Handle, &Cfg, 0xB9, 1, &Cnfg02, 1, &Xfer, 500) == I2C_SUCCESS) {
+          Cnfg02 = (UINT8)((Cnfg02 & ~0xC0U) | 0xC0U); // MAX77705_OTG_ILIM_1500
+          I2c->write (Handle, &Cfg, 0xB9, 1, &Cnfg02, 1, &Xfer, 500);
+        }
+
+        // Keep BUCK (bit 2) ON + OTG (bit 1) + BOOST (bit 3) = 0x0E/0x0F, AND clear WDTEN (bit 4)
+        // so the 80s charger watchdog NEVER kills 5V OTG VBUS in Windows!
+        if (I2c->read (Handle, &Cfg, 0xB7, 1, &Cnfg00, 1, &Xfer, 500) == I2C_SUCCESS) {
+          UINT8 Desired = (UINT8)(((Cnfg00 & 0x05U) | 0x0EU) & ~0x10U);
+          if (Cnfg00 != Desired) {
+            I2c->write (Handle, &Cfg, 0xB7, 1, &Desired, 1, &Xfer, 500);
+          }
+        }
+      }
+
+      if (I2c->close != NULL) I2c->close (Handle);
+      break;
+    }
+
+    if (I2c->close != NULL) I2c->close (Handle);
+  }
+}
