+ EFIAPI
+ BootManagerMenuEntry (
+@@ -1107,59 +1171,149 @@ BootManagerMenuEntry (
+   DrawBootPopupMenu (&BootMenuData);
+ 
+   //
+-  // check user input to determine want to re-draw or boot from user selected item
++  // Check user input with 15s auto-boot timer and Vol+ & Vol- combo as Enter
+   //
+-  ExitApplication = FALSE;
+-  while (!ExitApplication) {
+-    gBS->WaitForEvent (1, &gST->ConIn->WaitForKey, &Index);
+-    Status = gST->ConIn->ReadKeyStroke (gST->ConIn, &Key);
++  {
++    EFI_EVENT  TimerEvent;
++    EFI_EVENT  WaitList[2];
++    UINTN      CountdownSeconds;
++    UINTN      TickCounter;
++    UINTN      TotalTicks;
++    UINT16     LastScanCode;
++    UINTN      LastKeyTick;
++    UINTN      PreComboItem;
++    BOOLEAN    ExecuteSelected;
++
++    TimerEvent       = NULL;
++    CountdownSeconds = AUTO_BOOT_TIMEOUT_SECONDS;
++    TickCounter      = 0;
++    TotalTicks       = 0;
++    LastScanCode     = SCAN_NULL;
++    LastKeyTick      = 0;
++    PreComboItem     = BootMenuData.SelectItem;
++    ExecuteSelected  = FALSE;
++
++    Status = gBS->CreateEvent (EVT_TIMER, TPL_CALLBACK, NULL, NULL, &TimerEvent);
+     if (!EFI_ERROR (Status)) {
+-      switch (Key.UnicodeChar) {
+-        case CHAR_NULL:
+-          switch (Key.ScanCode) {
+-            case SCAN_UP:
+-              SelectItem = BootMenuData.SelectItem == 0 ? BootMenuData.ItemCount - 1 : BootMenuData.SelectItem - 1;
+-              BootMenuSelectItem (SelectItem, &BootMenuData);
+-              break;
++      gBS->SetTimer (TimerEvent, TimerPeriodic, TIMER_TICK_100NS);
++    }
++
++    DrawAutoBootCountdown (&BootMenuData, CountdownSeconds);
++
++    ExitApplication = FALSE;
++    while (!ExitApplication) {
++      if (TimerEvent != NULL) {
++        WaitList[0] = gST->ConIn->WaitForKey;
++        WaitList[1] = TimerEvent;
++        gBS->WaitForEvent (2, WaitList, &Index);
++      } else {
++        gBS->WaitForEvent (1, &gST->ConIn->WaitForKey, &Index);
++      }
++
++      if (Index == 1) {
++        TotalTicks++;
++        TickCounter++;
++        if (TickCounter >= TICKS_PER_SECOND) {
++          TickCounter = 0;
++          if (CountdownSeconds > 0) {
++            CountdownSeconds--;
++          }
++
++          DrawAutoBootCountdown (&BootMenuData, CountdownSeconds);
++          if (CountdownSeconds == 0) {
++            ExecuteSelected = TRUE;
++          }
++        }
++      } else {
++        Status = gST->ConIn->ReadKeyStroke (gST->ConIn, &Key);
++        if (!EFI_ERROR (Status)) {
++          switch (Key.UnicodeChar) {
++            case CHAR_NULL:
++              switch (Key.ScanCode) {
++                case SCAN_UP:
++                case SCAN_DOWN:
++                  if ((LastScanCode != SCAN_NULL) &&
++                      (LastScanCode != Key.ScanCode) &&
++                      ((TotalTicks - LastKeyTick) <= COMBO_WINDOW_TICKS))
++                  {
++                    // Vol+ and Vol- pressed together -> confirm selected option
++                    BootMenuSelectItem (PreComboItem, &BootMenuData);
++                    LastScanCode    = SCAN_NULL;
++                    ExecuteSelected = TRUE;
++                  } else {
++                    PreComboItem = BootMenuData.SelectItem;
++                    LastScanCode = Key.ScanCode;
++                    LastKeyTick  = TotalTicks;
++                    if (Key.ScanCode == SCAN_UP) {
++                      SelectItem = BootMenuData.SelectItem == 0 ? BootMenuData.ItemCount - 1 : BootMenuData.SelectItem - 1;
++                    } else {
++                      SelectItem = BootMenuData.SelectItem == BootMenuData.ItemCount - 1 ? 0 : BootMenuData.SelectItem + 1;
++                    }
++
++                    BootMenuSelectItem (SelectItem, &BootMenuData);
++                    CountdownSeconds = AUTO_BOOT_TIMEOUT_SECONDS;
++                    TickCounter      = 0;
++                    DrawAutoBootCountdown (&BootMenuData, CountdownSeconds);
++                  }
++
++                  break;
++
++                case SCAN_ESC:
++                  gST->ConOut->ClearScreen (gST->ConOut);
++                  ExitApplication = TRUE;
++                  //
++                  // Set boot resolution for normal boot
++                  //
++                  BdsSetConsoleMode (FALSE);
++                  break;
++
++                default:
++                  break;
++              }
+ 
+-            case SCAN_DOWN:
+-              SelectItem = BootMenuData.SelectItem == BootMenuData.ItemCount - 1 ? 0 : BootMenuData.SelectItem + 1;
+-              BootMenuSelectItem (SelectItem, &BootMenuData);
+               break;
+ 
+-            case SCAN_ESC:
+-              gST->ConOut->ClearScreen (gST->ConOut);
+-              ExitApplication = TRUE;
+-              //
+-              // Set boot resolution for normal boot
+-              //
+-              BdsSetConsoleMode (FALSE);
++            case CHAR_CARRIAGE_RETURN:
++              ExecuteSelected = TRUE;
+               break;
+ 
+             default:
+               break;
+           }
++        }
++      }
+ 
+-          break;
+-
+-        case CHAR_CARRIAGE_RETURN:
+-          gST->ConOut->ClearScreen (gST->ConOut);
+-          //
+-          // Set boot resolution for normal boot
+-          //
+-          BdsSetConsoleMode (FALSE);
+-          BootFromSelectOption (BootOption, BootOptionCount, BootMenuData.SelectItem);
+-          //
+-          // Back to boot manager menu again, set back to setup resolution
+-          //
+-          BdsSetConsoleMode (TRUE);
+-          DrawBootPopupMenu (&BootMenuData);
+-          break;
++      if (ExecuteSelected) {
++        ExecuteSelected = FALSE;
++        if (TimerEvent != NULL) {
++          gBS->SetTimer (TimerEvent, TimerCancel, 0);
++        }
+ 
+-        default:
+-          break;
++        gST->ConOut->ClearScreen (gST->ConOut);
++        //
++        // Set boot resolution for normal boot
++        //
++        BdsSetConsoleMode (FALSE);
++        BootFromSelectOption (BootOption, BootOptionCount, BootMenuData.SelectItem);
++        //
++        // Back to boot manager menu again, set back to setup resolution
++        //
++        BdsSetConsoleMode (TRUE);
++        DrawBootPopupMenu (&BootMenuData);
++        CountdownSeconds = AUTO_BOOT_TIMEOUT_SECONDS;
++        TickCounter      = 0;
++        LastScanCode     = SCAN_NULL;
++        DrawAutoBootCountdown (&BootMenuData, CountdownSeconds);
++        if (TimerEvent != NULL) {
++          gBS->SetTimer (TimerEvent, TimerPeriodic, TIMER_TICK_100NS);
++        }
+       }
+     }
++
++    if (TimerEvent != NULL) {
++      gBS->SetTimer (TimerEvent, TimerCancel, 0);
++      gBS->CloseEvent (TimerEvent);
++    }
+   }
+ 
+   EfiBootManagerFreeLoadOptions (BootOption, BootOptionCount);
