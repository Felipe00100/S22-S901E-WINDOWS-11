+
+EFI_DEVICE_PATH_PROTOCOL**
+EFIAPI
+DeviceBootManagerAfterConsole ()
+{
+  EFI_STATUS Status;
+  EFI_EVENT  InitEvent;
+
+  // Check for one-shot TWRP recovery reboot flag written from Windows Desktop
+  S22CheckRebootTwrpFlag ();
+
+  // Power on Galaxy S22 (r0q) FTS2BA61Y touchscreen + USB + PCIe0/WCN6855 RPMh rails
+  S22EnableTouchRails ();
+
+  // Stage 1: Bring up WCN6855 + SM8450 PCIe0 RC & log link/VID:DID to \EFI\S22\pcie_log.txt
+  S22InitWlanAndPcie0 ();
+  S22FlushPcieLog ();
+
+  // Configure SM8450 DWC3 in USB Host mode + 5V OTG boost (when no external VBUS/charger)
+  S22PrepareUsbHost ();
+
+  // Create SD Card Init Event
+  Status = gBS->CreateEventEx (EVT_NOTIFY_SIGNAL, TPL_CALLBACK, DummyNotify, NULL, &gSdCardInitGuid, &InitEvent);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((EFI_D_ERROR, "%a: Failed to Create SD Card Init Event! Status = %r\n", __FUNCTION__, Status));
+    return NULL;
+  }
+
+  // Init SD Card
+  gBS->SignalEvent (InitEvent);
+  gBS->CloseEvent  (InitEvent);
+
+  return NULL;
+}
+
+EFI_DEVICE_PATH_PROTOCOL**
+EFIAPI
+DeviceBootManagerOnDemandConInConnect ()
+{
+  EFI_STATUS Status;
+  EFI_EVENT  InitEvent;
+
+  // Create USB Controller Start Event
+  Status = gBS->CreateEventEx (EVT_NOTIFY_SIGNAL, TPL_CALLBACK, DummyNotify, NULL, &gUsbControllerInitGuid, &InitEvent);
+  if (EFI_ERROR (Status)) {
+    DEBUG ((EFI_D_ERROR, "%a: Failed to Create USB Port Controller Start Event! Status = %r\n", __FUNCTION__, Status));
+    return NULL;
+  }
+
+  // Start USB Controller
+  gBS->SignalEvent (InitEvent);
+  gBS->CloseEvent  (InitEvent);
+
+  return NULL;
+}
